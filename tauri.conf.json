{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jambul",
  "version": "0.1.0",
  "identifier": "dev.jambul.app",
  "build": { "frontendDist": "./dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "width": 600,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
